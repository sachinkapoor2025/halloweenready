2f:["$","$L30",null,{"product":{"name":"Foam Tombstone Decor – Set of 3","slug":"foam-tombstone-decor-set-of-3","description":"Create a chilling graveyard scene with the Foam Tombstone Decor – Set of 3. Designed to resemble realistic cemetery headstones, these lightweight foam decorations are perfect for Halloween yard displays, haunted houses, graveyard scenes, spooky parties, and horror-themed events. Made from durable foam material, these tombstones are easy to place in gardens, lawns, walkways, party entrances, and indoor displays. The realistic stone-look design adds a creepy touch to your Halloween setup while remaining lightweight and easy to move. Perfect for haunted house attractions, trick-or-treat pathways, outdoor Halloween decorations, photo backdrops, and spooky party themes, this set of 3 tombstones helps transform any space into a haunted graveyard. Reusable and easy to store, they are a must-have for seasonal decorating.","price":16.99,"compareAtPrice":20,"currency":"USD","categorySlug":"toysandnovelty","images":["https://halloweenready.com/wp-content/uploads/2026/05/Foam-Tombstone-Decor-–-Set-of-3.png"],"inventory":200,"tags":["Foam Tombstones","Graveyard Decorations","Halloween Tombstones","Halloween Yard Décor","Haunted House"],"seoTitle":"Foam Tombstone Decor – Set of 3","seoDescription":"Create a chilling graveyard scene with the Foam Tombstone Decor – Set of 3."},"relatedProducts":[{"name":"Mini Cauldron Candy Bowl – 4 inch Plastic","slug":"mini-cauldron-candy-bowl-4-inch-plastic","description":"Serve treats with magical Halloween charm using the Mini Cauldron Candy Bowl – 4 Inch Plastic. Designed like a classic witch’s cauldron, this miniature candy bowl is perfect for holding chocolates, candies, snacks, party favors, and trick-or-treat goodies during Halloween celebrations. Made from durable lightweight plastic, this 4-inch cauldron bowl is easy to carry, reusable, and ideal for both decorative and practical use. Its spooky witch-inspired design makes it a great addition to Halloween party tables, haunted house displays, candy stations, photo props, and festive décor setups. Perfect for homes, classrooms, offices, cafés, and Halloween events, this mini cauldron adds a fun and magical touch to seasonal celebrations. Use it as a candy holder, table decoration, party favor container, or spooky centerpiece accessory","price":4.83,"compareAtPrice":8,"currency":"USD","categorySlug":"toysandnovelty","images":["https://halloweenready.com/wp-content/uploads/2026/05/Mini-Cauldron-Candy-Bowl-–-4-inch-Plastic.png"],"inventory":200,"tags":["Halloween Candy Bowl","Halloween Party Supplies","Mini Cauldron Bowl","Plastic","Witch Cauldron Decoration"],"seoTitle":"Mini Cauldron Candy Bowl – 4 inch Plastic","seoDescription":"Serve treats with magical Halloween charm using the Mini Cauldron Candy Bowl – 4 Inch Plastic."},{"name":"Halloween Fidget Spinner – Skull Design","slug":"halloween-fidget-spinner-skull-design","description":"Add spooky fun to playtime with the Halloween Fidget Spinner – Skull Design. Featuring a cool skull-themed design, this Halloween-inspired fidget spinner is perfect for kids, teens, party favors, trick-or-treat gifts, classroom rewards, and seasonal fun activities. Designed for smooth spinning performance, this lightweight spinner helps keep hands busy while providing a fun sensory experience. The unique skull design makes it a standout accessory for Halloween parties, haunted house events, costume giveaways, and spooky-themed celebrations.","price":4.83,"compareAtPrice":7,"currency":"USD","categorySlug":"toysandnovelty","images":["https://halloweenready.com/wp-content/uploads/2026/05/Halloween-Fidget-Spinner-–-Skull-Design.png"],"inventory":200,"tags":["Fidget Toy","Halloween Fidget Spinner","Halloween Party Favors","Halloween Toys","Skull","Skull Fidget Spinner"],"seoTitle":"Halloween Fidget Spinner – Skull Design","seoDescription":"Add spooky fun to playtime with the Halloween Fidget Spinner – Skull Design."},{"name":"Flying Ghost Mobile – Ceiling Hang Set of 3","slug":"flying-ghost-mobile-ceiling-hang-set-of-3","description":"Bring spooky movement to your Halloween décor with the Flying Ghost Mobile – Ceiling Hang Set of 3. Featuring three floating ghost decorations, this hanging mobile set creates a haunting visual effect that is perfect for Halloween parties, haunted houses, classrooms, offices, and seasonal home décor. Made from lightweight materials, these ghost mobiles gently sway with air movement, giving the appearance of floating spirits. Easy to hang from ceilings, doorways, porches, party tents, and event spaces, they instantly add a fun and eerie Halloween atmosphere. Perfect for indoor decorations, party backdrops, photo booths, trick-or-treat setups, and spooky displays, these reusable hanging ghosts pair beautifully with spider webs, bats, pumpkins, and other Halloween decorations.","price":5.99,"compareAtPrice":9,"currency":"USD","categorySlug":"toysandnovelty","images":["https://halloweenready.com/wp-content/uploads/2026/05/Flying-Ghost-Mobile-–-Ceiling-Hang-Set-of-3.png"],"inventory":200,"tags":["Flying Ghost Mobile","Ghost","Halloween Ceiling Décor","Halloween Decorations","Hanging Ghost Decorations"],"seoTitle":"Flying Ghost Mobile – Ceiling Hang Set of 3","seoDescription":"Bring spooky movement to your Halloween décor with the Flying Ghost Mobile – Ceiling Hang Set of 3."},{"name":"Inflatable Pumpkin Yard Decor – 24 inch","slug":"inflatable-pumpkin-yard-decor-24-inch","description":"Make your Halloween display stand out with the Inflatable Pumpkin Yard Decor – 24 Inch. Featuring a classic jack-o’-lantern pumpkin design, this eye-catching inflatable decoration is perfect for front yards, gardens, porches, lawns, party entrances, haunted houses, and festive Halloween displays. Made from durable and lightweight material, this 24-inch inflatable pumpkin is easy to set up, move, and store after the season. Its bright and cheerful pumpkin appearance adds a fun spooky touch to outdoor and indoor Halloween decorations while creating a welcoming atmosphere for trick-or-treaters and guests.","price":25.99,"compareAtPrice":30,"currency":"USD","categorySlug":"toysandnovelty","images":["https://halloweenready.com/wp-content/uploads/2026/05/Inflatable-Pumpkin-Yard-Decor-–-24-inch.png"],"inventory":200,"tags":["Halloween Outdoor Decorations","Halloween Yard Décor","Inflatable Pumpkin","Jack","Pumpkin Lawn Decoration"],"seoTitle":"Inflatable Pumpkin Yard Decor – 24 inch","seoDescription":"Make your Halloween display stand out with the Inflatable Pumpkin Yard Decor – 24 Inch."},{"name":"Mini Plastic Spiders – Bag of 100","slug":"mini-plastic-spiders-bag-of-100","description":"Create the ultimate creepy Halloween atmosphere with the Mini Plastic Spiders – Bag of 100. This value pack includes 100 realistic mini spider decorations, perfect for haunted houses, Halloween parties, table displays, trick-or-treat setups, crafts, and spooky prank ideas. Made from durable lightweight plastic, these miniature spiders are easy to scatter across tables, spider webs, shelves, gift bags, party favors, and decorative displays. Their realistic design adds an extra spooky touch to Halloween décor and pairs perfectly with cobwebs, skeletons, pumpkins, and haunted house props.","price":4.26,"compareAtPrice":6,"currency":"USD","categorySlug":"toysandnovelty","images":["https://halloweenready.com/wp-content/uploads/2026/05/Mini-Plastic-Spiders-–-Bag-of-100.png"],"inventory":200,"tags":["Halloween Party Supplies","Halloween Spider Decorations","Mini Plastic Spiders","Plastic Spiders","Spider Web"],"seoTitle":"Mini Plastic Spiders – Bag of 100","seoDescription":"Create the ultimate creepy Halloween atmosphere with the Mini Plastic Spiders – Bag of 100."}]}]
