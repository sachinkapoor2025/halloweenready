2c:T508,{"@context":"https://schema.org","@type":"Product","@id":"http://localhost:3000/products/foam-tombstone-decor-set-of-3#product","name":"Foam Tombstone Decor – Set of 3","description":"Create a chilling graveyard scene with the Foam Tombstone Decor – Set of 3.","image":["https://halloweenready.com/wp-content/uploads/2026/05/Foam-Tombstone-Decor-–-Set-of-3.png"],"sku":"foam-tombstone-decor-set-of-3","mpn":"foam-tombstone-decor-set-of-3","url":"http://localhost:3000/products/foam-tombstone-decor-set-of-3","brand":{"@type":"Brand","name":"HalloweenReady"},"category":"toysandnovelty","offers":{"@type":"Offer","url":"http://localhost:3000/products/foam-tombstone-decor-set-of-3","price":16.99,"priceCurrency":"USD","itemCondition":"https://schema.org/NewCondition","availability":"https://schema.org/InStock","seller":{"@id":"http://localhost:3000/#organization"},"shippingDetails":{"@type":"OfferShippingDetails","shippingRate":{"@type":"MonetaryAmount","value":"0","currency":"USD"},"deliveryTime":{"@type":"ShippingDeliveryTime","handlingTime":{"@type":"QuantitativeValue","minValue":0,"maxValue":1,"unitCode":"DAY"},"transitTime":{"@type":"QuantitativeValue","minValue":5,"maxValue":7,"unitCode":"DAY"}},"shippingDestination":{"@type":"DefinedRegion","addressCountry":"US"}}}}2d:T509,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does delivery take in the USA?","acceptedAnswer":{"@type":"Answer","text":"HalloweenReady delivers to all 50 US states in 5–7 business days after dispatch. Orders placed before our daily cut-off ship the same day."}},{"@type":"Question","name":"Can I order from India, UK, or Canada?","acceptedAnswer":{"@type":"Answer","text":"Yes. Enter your brother's US delivery address at checkout. We fulfill domestically inside America — no customs hassle for your brother."}},{"@type":"Question","name":"Is roli and chawal included?","acceptedAnswer":{"@type":"Answer","text":"Most single Halloween items include complimentary roli (kumkum) and chawal (rice) for the traditional Halloween tilak ceremony."}},{"@type":"Question","name":"What payment methods do you accept?","acceptedAnswer":{"@type":"Answer","text":"We accept Stripe (USD) and Razorpay (INR). All payments are encrypted and we never store card details."}},{"@type":"Question","name":"What if my Halloween arrives damaged?","acceptedAnswer":{"@type":"Answer","text":"Contact us within 48 hours of delivery with photos. We offer replacements or refunds for damaged or incorrect items — see our Returns & Guarantee policy."}}]}1f:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2c"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"http://localhost:3000\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Shop\",\"item\":\"http://localhost:3000/products\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"toysandnovelty\",\"item\":\"http://localhost:3000/categories/toysandnovelty\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Foam Tombstone Decor – Set of 3\",\"item\":\"http://localhost:3000/products/foam-tombstone-decor-set-of-3\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2d"}}]],"$L2e","$L2f"]
