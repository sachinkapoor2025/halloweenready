2f:["$","$L30",null,{"product":{"name":"Halloween Kitchen Apron – Printed","slug":"halloween-kitchen-apron-printed","description":"Cook, bake, and celebrate in spooky style with the Halloween Kitchen Apron – Printed. Featuring festive Halloween-themed prints such as pumpkins, ghosts, bats, witches, and spooky patterns, this decorative apron is perfect for Halloween baking, cooking, BBQs, parties, and seasonal kitchen décor. Made from durable and comfortable fabric, this apron helps protect clothing from spills, stains, and splashes while adding a fun Halloween touch to your kitchen activities. The adjustable design provides a comfortable fit, making it suitable for everyday cooking, baking sessions, festive gatherings, and themed events.","price":12.99,"compareAtPrice":17,"currency":"USD","categorySlug":"lifestyleandwearable","images":["https://halloweenready.com/wp-content/uploads/2026/05/Halloween-Kitchen-Apron-–-Printed.png"],"inventory":200,"tags":["Cooking Apron","Halloween Apron","Halloween Baking Accessories","Kitchen Apron","Printed Halloween Apron"],"seoTitle":"Halloween Kitchen Apron – Printed","seoDescription":"Cook, bake, and celebrate in spooky style with the Halloween Kitchen Apron – Printed."},"relatedProducts":[{"name":"Halloween Enamel Pin Set – 5 Pins","slug":"halloween-enamel-pin-set-5-pins","description":"Show off your spooky style with the Halloween Enamel Pin Set – 5 Pins. This festive collection includes five Halloween-themed enamel pins featuring fun designs such as pumpkins, ghosts, bats, skulls, witches, or other spooky seasonal icons. Perfect for adding personality to jackets, backpacks, hats, tote bags, lanyards, and clothing. Crafted with durable enamel and metal construction, these decorative pins are lightweight, stylish, and designed for everyday wear. The colorful Halloween-inspired designs make them ideal for costume accessories, gothic fashion, cosplay events, seasonal outfits, and collectible pin displays.","price":9.99,"compareAtPrice":13,"currency":"USD","categorySlug":"lifestyleandwearable","images":["https://halloweenready.com/wp-content/uploads/2026/05/Halloween-Enamel-Pin-Set-–-5-Pins.png"],"inventory":200,"tags":["Enamel Lapel Pins","Ghost","Halloween Accessories","Halloween Enamel Pins","Halloween Pin Set","Pumpkin Pin"],"seoTitle":"Halloween Enamel Pin Set – 5 Pins","seoDescription":"Show off your spooky style with the Halloween Enamel Pin Set – 5 Pins."},{"name":"Spooky Printed Mug – Ceramic 350ml","slug":"spooky-printed-mug-ceramic-350ml","description":"Enjoy your favorite drinks with a spooky twist using the Spooky Printed Mug – Ceramic 350ml. Featuring fun Halloween-themed prints such as pumpkins, ghosts, bats, skulls, witches, and spooky sayings, this ceramic mug is perfect for coffee, tea, hot chocolate, and seasonal beverages. Made from high-quality ceramic, this 350ml mug is durable, comfortable to hold, and ideal for daily use at home, in the office, or during Halloween celebrations. The festive design adds a touch of Halloween spirit to your kitchen, desk, coffee station, or seasonal décor collection. Perfect for Halloween lovers, gift giving, themed parties, and autumn mornings, this reusable mug combines practicality with spooky seasonal charm. Pair it with Halloween candles, decorations, and treats for the ultimate festive experience.","price":11.99,"compareAtPrice":15,"currency":"USD","categorySlug":"lifestyleandwearable","images":["https://halloweenready.com/wp-content/uploads/2026/05/Spooky-Printed-Mug-–-Ceramic-350ml.png"],"inventory":200,"tags":["Ceramic Coffee Mug","Ghost","Halloween Drinkware","Halloween Mug","Pumpkin Mug","Spooky Printed Mug"],"seoTitle":"Spooky Printed Mug – Ceramic 350ml","seoDescription":"Enjoy your favorite drinks with a spooky twist using the Spooky Printed Mug – Ceramic 350ml."},{"name":"Skull Print Cushion Cover – Pair 16&#215;16","slug":"skull-print-cushion-cover-pair-16x16","description":"Add a spooky decorative touch to your home with the Skull Print Cushion Cover – Pair 16&#215;16. Featuring stylish skull-themed prints, these decorative cushion covers are perfect for Halloween décor, gothic interiors, haunted house setups, themed parties, and seasonal home styling. Made from soft and durable fabric, these 16&#215;16 inch cushion covers are designed to fit standard throw pillows and instantly transform sofas, chairs, beds, and lounge areas with a spooky Halloween vibe. The eye-catching skull design pairs beautifully with pumpkins, candles, spider webs, and other festive decorations. Perfect for living rooms, bedrooms, offices, cafés, party venues, and seasonal displays, this set of two cushion covers offers an easy way to refresh your décor for Halloween and gothic-themed celebrations. Reusable and easy to maintain, they are a stylish addition to any spooky setup.","price":11.99,"compareAtPrice":15,"currency":"USD","categorySlug":"lifestyleandwearable","images":["https://halloweenready.com/wp-content/uploads/2026/05/Skull-Print-Cushion-Cover-–-Pair-16x16-1.png"],"inventory":200,"tags":["Gothic","Halloween Cushion Cover","Halloween Home Décor","Skull Cushion Cover","Skull Print Pillow Cover"],"seoTitle":"Skull Print Cushion Cover – Pair 16&#215;16","seoDescription":"Add a spooky decorative touch to your home with the Skull Print Cushion Cover – Pair 16&#215;16."},{"name":"Halloween Tote Bag – Printed Cotton","slug":"halloween-tote-bag-printed-cotton","description":"Carry your Halloween essentials in spooky style with the Halloween Tote Bag – Printed Cotton. Made from durable cotton fabric, this reusable tote bag features festive Halloween-themed prints such as pumpkins, ghosts, bats, witches, skulls, and spooky seasonal designs. Perfect for trick-or-treating, shopping, party favors, school events, book carrying, and everyday use, this lightweight tote bag combines practicality with Halloween charm. The sturdy handles provide comfortable carrying, while the spacious interior offers plenty of room for candies, gifts, groceries, books, and daily essentials.","price":9.99,"compareAtPrice":13,"currency":"USD","categorySlug":"lifestyleandwearable","images":["https://halloweenready.com/wp-content/uploads/2026/05/Halloween-Tote-Bag-–-Printed-Cotton.png"],"inventory":200,"tags":["Halloween Shopping Bag","Halloween Tote Bag","Printed Cotton Tote Bag","Reusable","Trick or Treat Bag"],"seoTitle":"Halloween Tote Bag – Printed Cotton","seoDescription":"Carry your Halloween essentials in spooky style with the Halloween Tote Bag – Printed Cotton."}]}]
