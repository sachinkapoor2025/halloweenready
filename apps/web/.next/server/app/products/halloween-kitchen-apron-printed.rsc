2c:T526,{"@context":"https://schema.org","@type":"Product","@id":"http://localhost:3000/products/halloween-kitchen-apron-printed#product","name":"Halloween Kitchen Apron – Printed","description":"Cook, bake, and celebrate in spooky style with the Halloween Kitchen Apron – Printed.","image":["https://halloweenready.com/wp-content/uploads/2026/05/Halloween-Kitchen-Apron-–-Printed.png"],"sku":"halloween-kitchen-apron-printed","mpn":"halloween-kitchen-apron-printed","url":"http://localhost:3000/products/halloween-kitchen-apron-printed","brand":{"@type":"Brand","name":"HalloweenReady"},"category":"lifestyleandwearable","offers":{"@type":"Offer","url":"http://localhost:3000/products/halloween-kitchen-apron-printed","price":12.99,"priceCurrency":"USD","itemCondition":"https://schema.org/NewCondition","availability":"https://schema.org/InStock","seller":{"@id":"http://localhost:3000/#organization"},"shippingDetails":{"@type":"OfferShippingDetails","shippingRate":{"@type":"MonetaryAmount","value":"0","currency":"USD"},"deliveryTime":{"@type":"ShippingDeliveryTime","handlingTime":{"@type":"QuantitativeValue","minValue":0,"maxValue":1,"unitCode":"DAY"},"transitTime":{"@type":"QuantitativeValue","minValue":5,"maxValue":7,"unitCode":"DAY"}},"shippingDestination":{"@type":"DefinedRegion","addressCountry":"US"}}}}2d:T509,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does delivery take in the USA?","acceptedAnswer":{"@type":"Answer","text":"HalloweenReady delivers to all 50 US states in 5–7 business days after dispatch. Orders placed before our daily cut-off ship the same day."}},{"@type":"Question","name":"Can I order from India, UK, or Canada?","acceptedAnswer":{"@type":"Answer","text":"Yes. Enter your brother's US delivery address at checkout. We fulfill domestically inside America — no customs hassle for your brother."}},{"@type":"Question","name":"Is roli and chawal included?","acceptedAnswer":{"@type":"Answer","text":"Mo