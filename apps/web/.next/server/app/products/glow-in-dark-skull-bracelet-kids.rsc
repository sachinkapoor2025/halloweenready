2f:["$","$L30",null,{"product":{"name":"Glow-in-Dark Skull Bracelet – Kids","slug":"glow-in-dark-skull-bracelet-kids","description":"Make Halloween extra fun with the Glow-in-Dark Skull Bracelet – Kids. Featuring spooky skull-themed designs with a glowing effect, this playful bracelet is perfect for Halloween parties, trick-or-treating, school events, cosplay, and festive dress-up fun. Designed especially for kids, this lightweight and comfortable bracelet glows in the dark to create an exciting spooky effect during nighttime celebrations. The fun skull design pairs perfectly with Halloween costumes, skeleton outfits, ghost themes, and party accessories.","price":4.8,"compareAtPrice":7.99,"currency":"USD","categorySlug":"jewellryandaccessories","images":["https://halloweenready.com/wp-content/uploads/2026/05/Glow-in-Dark-Skull-Bracelet-–-Kids.png"],"inventory":200,"tags":["Glow in Dark","Glow Skull Bracelet","Halloween Jewelry","Kids Halloween Bracelet","Skull Bracelet Kids"],"seoTitle":"Glow-in-Dark Skull Bracelet – Kids","seoDescription":"Make Halloween extra fun with the Glow-in-Dark Skull Bracelet – Kids."},"relatedProducts":[{"name":"Gothic Cross Pendant – Oxidised Metal","slug":"gothic-cross-pendant-oxidised-metal","description":"Add a dark elegant touch to your outfit with the Gothic Cross Pendant – Oxidised Metal. Featuring a detailed gothic-style cross design with an antique oxidised metal finish, this stylish pendant is perfect for gothic fashion, Halloween outfits, cosplay events, punk style, vampire looks, and alternative fashion accessories. Crafted for both durability and style, this pendant creates a bold statement look that pairs beautifully with black outfits, gothic dresses, leather jackets, and spooky costumes. The vintage oxidised finish adds a dramatic dark aesthetic, making it ideal for concerts, themed parties, cosplay photoshoots, and everyday gothic wear. Lightweight and comfortable to wear, this reusable pendant is suitable for both men and women who love gothic-inspired jewelry and edgy fashion accessories.","price":9.99,"compareAtPrice":12.99,"currency":"USD","categorySlug":"jewellryandaccessories","images":["https://halloweenready.com/wp-content/uploads/2026/05/Gothic-Cross-Pendant-–-Oxidised-Metal.png"],"inventory":200,"tags":["Gothic Cross Pendant","Gothic Fashion","Gothic Jewelry","Halloween Accessories","Oxidised Metal Pendant"],"seoTitle":"Gothic Cross Pendant – Oxidised Metal","seoDescription":"Add a dark elegant touch to your outfit with the Gothic Cross Pendant – Oxidised Metal."},{"name":"Witch Hat Charm Keychain","slug":"witch-hat-charm-keychain","description":"Carry spooky style everywhere with the Witch Hat Charm Keychain. Featuring a cute witch hat charm design, this Halloween-inspired keychain is perfect for decorating keys, handbags, backpacks, purses, and party favor bags during spooky season celebrations. Made from lightweight and durable materials, this stylish keychain adds a fun gothic touch to everyday accessories while pairing perfectly with Halloween costumes, witch-themed outfits, and festive décor. The detailed witch hat design makes it ideal for Halloween parties, cosplay events, trick-or-treat favors, and seasonal gifting.","price":4,"compareAtPrice":7,"currency":"USD","categorySlug":"jewellryandaccessories","images":["https://halloweenready.com/wp-content/uploads/2026/05/Witch-Hat-Charm-Keychain.png"],"inventory":200,"tags":["Halloween Keychain","Witch Charm Accessory","Witch Hat Keychain"],"seoTitle":"Witch Hat Charm Keychain","seoDescription":"Carry spooky style everywhere with the Witch Hat Charm Keychain."},{"name":"Halloween Hair Clips Set – Bat/Ghost 6pc","slug":"halloween-hair-clips-set-bat-ghost-6pc","description":"Add a cute spooky touch to your hairstyle with the Halloween Hair Clips Set – Bat/Ghost 6pc. This festive hair accessory set includes adorable bat and ghost-themed clips perfect for Halloween parties, cosplay events, school celebrations, trick-or-treating, and spooky seasonal fashion. Designed for comfort and easy wear, these lightweight hair clips securely hold hair while adding playful Halloween charm to any outfit. The fun bat and ghost designs pair perfectly with witch costumes, gothic fashion, pumpkin outfits, and festive dress-up looks.","price":5.99,"compareAtPrice":7.99,"currency":"USD","categorySlug":"jewellryandaccessories","images":["https://halloweenready.com/wp-content/uploads/2026/05/Halloween-Hair-Clips-Set-–-BatGhost-6pc.png"],"inventory":200,"tags":["Bat Hair Clips","Ghost Hair Clips","Halloween Accessories","Halloween Hair Clips"],"seoTitle":"Halloween Hair Clips Set – Bat/Ghost 6pc","seoDescription":"Add a cute spooky touch to your hairstyle with the Halloween Hair Clips Set – Bat/Ghost 6pc."},{"name":"Skeleton Hand Ring – Adjustable","slug":"skeleton-hand-ring-adjustable","description":"Add a bold spooky touch to your look with the Skeleton Hand Ring – Adjustable. Designed with a detailed skeleton hand shape, this gothic-inspired ring is perfect for Halloween costumes, cosplay events, punk fashion, vampire outfits, and horror-themed accessories. Made for style and comfort, the adjustable design provides a flexible fit for most finger sizes, making it easy to wear during parties, concerts, themed photoshoots, and festive celebrations. The creepy skeleton hand detail creates a dramatic gothic look that pairs perfectly with witch outfits, dark fashion, and spooky makeup.","price":4.8,"compareAtPrice":6.99,"currency":"USD","categorySlug":"jewellryandaccessories","images":["https://halloweenready.com/wp-content/uploads/2026/05/Skeleton-Hand-Ring-–-Adjustable.png"],"inventory":200,"tags":["Adjustable Ring","Gothic Ring","Halloween Jewelry","Skeleton Hand Ring","Skeleton Ring","Spooky Fashion"],"seoTitle":"Skeleton Hand Ring – Adjustable","seoDescription":"Add a bold spooky touch to your look with the Skeleton Hand Ring – Adjustable."},{"name":"Black Cat Stud Earrings","slug":"black-cat-stud-earrings","description":"Show off your spooky style with the Black Cat Stud Earrings. Featuring adorable black cat-inspired designs, these Halloween-themed earrings are perfect for gothic fashion, witch costumes, cosplay events, autumn outfits, and festive seasonal accessories. Lightweight and comfortable to wear, these stud earrings add a playful spooky touch to casual looks, Halloween costumes, and alternative fashion styles. The cute black cat design pairs perfectly with witch hats, gothic dresses, spooky makeup, and Halloween party outfits.","price":5.99,"compareAtPrice":7.99,"currency":"USD","categorySlug":"jewellryandaccessories","images":["https://halloweenready.com/wp-content/uploads/2026/05/Black-Cat-Stud-EarringsBlack-Cat-Stud-Earrings.png"],"inventory":200,"tags":["Black Cat Earrings","Cat Stud Earrings","Gothic Fashion Accessories","Halloween Jewelry"],"seoTitle":"Black Cat Stud Earrings","seoDescription":"Show off your spooky style with the Black Cat Stud Earrings."}]}]
