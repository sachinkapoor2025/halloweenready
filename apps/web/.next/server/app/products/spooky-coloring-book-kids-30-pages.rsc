2f:["$","$L30",null,{"product":{"name":"Spooky Coloring Book – Kids 30 Pages","slug":"spooky-coloring-book-kids-30-pages","description":"Keep kids entertained with spooky creative fun using the Spooky Coloring Book – Kids 30 Pages. Filled with 30 exciting Halloween-themed pages, this coloring book features fun illustrations of pumpkins, ghosts, bats, witches, black cats, monsters, and other spooky characters perfect for Halloween activities and seasonal creativity. Designed for children of all ages, this coloring book encourages imagination, creativity, and fine motor skills while providing hours of festive entertainment. The kid-friendly artwork makes it perfect for Halloween parties, classrooms, trick-or-treat events, school activities, travel fun, and holiday gifting.","price":4.99,"compareAtPrice":6.99,"currency":"USD","categorySlug":"printedandpapercrafts","images":["https://halloweenready.com/wp-content/uploads/2026/05/Spooky-Coloring-Book-–-Kids-30-Pages.png"],"inventory":200,"tags":["Halloween Coloring Book","Halloween Kids Activities","Kids Coloring Book","Pumpkin","Spooky Coloring Pages"],"seoTitle":"Spooky Coloring Book – Kids 30 Pages","seoDescription":"Keep kids entertained with spooky creative fun using the Spooky Coloring Book – Kids 30 Pages."},"relatedProducts":[{"name":"Halloween Greeting Cards – 12 Pack","slug":"halloween-greeting-cards-12-pack","description":"Send spooky wishes in festive style with the Halloween Greeting Cards – 12 Pack. Featuring fun Halloween-themed designs such as pumpkins, ghosts, bats, witches, and haunted houses, these greeting cards are perfect for sharing seasonal messages with friends, family, classmates, coworkers, and party guests. Made from quality cardstock material, these cards provide space for personalized notes, greetings, invitations, or thank-you messages. The colorful spooky artwork adds a festive Halloween touch, making them ideal for parties, classrooms, offices, trick-or-treat gifts, and seasonal celebrations. This 12-pack set is perfect for Halloween events, party favors, gift packaging, and holiday greetings. Pair them with Halloween gift tags, stickers, wrapping paper, and treat bags for a complete festive presentation.","price":8.99,"compareAtPrice":11.99,"currency":"USD","categorySlug":"printedandpapercrafts","images":["https://halloweenready.com/wp-content/uploads/2026/05/Halloween-Greeting-Cards-–-12-Pack.png"],"inventory":200,"tags":["Halloween Cards","Halloween Greeting Cards","Halloween Party Supplies","Pumpkin","Spooky Greeting Cards"],"seoTitle":"Halloween Greeting Cards – 12 Pack","seoDescription":"Send spooky wishes in festive style with the Halloween Greeting Cards – 12 Pack."},{"name":"Haunted House Jigsaw Puzzle – 500 Pieces","slug":"haunted-house-jigsaw-puzzle-500-pieces","description":"Enjoy spooky puzzle fun with the Haunted House Jigsaw Puzzle – 500 Pieces. Featuring a detailed haunted house scene filled with creepy Halloween elements, this puzzle is perfect for Halloween lovers, family game nights, seasonal activities, and relaxing indoor entertainment. Made with high-quality puzzle pieces, this 500-piece set offers a fun and engaging challenge for teens and adults while helping improve focus, problem-solving skills, and creativity. The spooky haunted house artwork includes ghosts, pumpkins, bats, dark forests, and eerie details that create the perfect Halloween atmosphere.","price":21.99,"compareAtPrice":25.99,"currency":"USD","categorySlug":"printedandpapercrafts","images":["https://halloweenready.com/wp-content/uploads/2026/05/Haunted-House-Jigsaw-Puzzle-–-500-Pieces.png"],"inventory":200,"tags":["Halloween Activities","Halloween Puzzle","Haunted House Puzzle","Jigsaw Puzzle 500 Pieces","Spooky Puzzle"],"seoTitle":"Haunted House Jigsaw Puzzle – 500 Pieces","seoDescription":"Enjoy spooky puzzle fun with the Haunted House Jigsaw Puzzle – 500 Pieces."},{"name":"Halloween Temporary Tattoos – 100 Pack","slug":"halloween-temporary-tattoos-100-pack","description":"Add spooky fun to Halloween celebrations with the Halloween Temporary Tattoos – 100 Pack. This exciting tattoo set features a variety of Halloween-themed designs including pumpkins, ghosts, bats, witches, skulls, spiders, monsters, and spooky symbols perfect for parties and festive dress-up. Easy to apply and remove, these temporary tattoos are safe for skin and ideal for kids, teens, and adults. Perfect for Halloween parties, trick-or-treat events, cosplay, classroom activities, party favors, candy bags, and festive photo booths.","price":5.99,"compareAtPrice":8.99,"currency":"USD","categorySlug":"printedandpapercrafts","images":["https://halloweenready.com/wp-content/uploads/2026/05/Halloween-Temporary-Tattoos-–-100-Pack.png"],"inventory":200,"tags":["Halloween Party Supplies","Halloween Temporary Tattoos","Kids Halloween Tattoos","Pumpkin","Spooky Tattoos"],"seoTitle":"Halloween Temporary Tattoos – 100 Pack","seoDescription":"Add spooky fun to Halloween celebrations with the Halloween Temporary Tattoos – 100 Pack."},{"name":"Halloween Gift Tags – 50 Pack","slug":"halloween-gift-tags-50-pack","description":"Add the perfect spooky finishing touch to your gifts with the Halloween Gift Tags – 50 Pack. Featuring festive Halloween-themed designs like pumpkins, ghosts, bats, skulls, and spooky patterns, these decorative gift tags are perfect for Halloween presents, party favors, treat bags, candy packaging, and seasonal celebrations. Made from durable cardstock material, these tags are easy to write on and ideal for adding names, messages, greetings, or party notes. Perfect for decorating gift boxes, wrapping paper, party bags, baked treats, and DIY Halloween crafts.","price":4.99,"compareAtPrice":6.99,"currency":"USD","categorySlug":"printedandpapercrafts","images":["https://halloweenready.com/wp-content/uploads/2026/05/Halloween-Gift-Tags-–-50-Pack.png"],"inventory":200,"tags":["Halloween Decorations","Halloween Gift Tags","Halloween Party Supplies","Pumpkin Gift Tags","Spooky Gift Tags"],"seoTitle":"Halloween Gift Tags – 50 Pack","seoDescription":"Add the perfect spooky finishing touch to your gifts with the Halloween Gift Tags – 50 Pack."},{"name":"Halloween Wrapping Paper Roll – 2 Pack","slug":"halloween-wrapping-paper-roll-2-pack","description":"Wrap your spooky gifts in festive style with the Halloween Wrapping Paper Roll – 2 Pack. Featuring fun Halloween-themed prints such as pumpkins, bats, ghosts, skulls, and spooky patterns, these decorative wrapping paper rolls are perfect for Halloween gifts, party favors, treat bags, and seasonal celebrations. Made from quality gift wrap paper, these rolls are easy to cut, fold, and use for wrapping presents, decorating party tables, crafting projects, and creating festive DIY decorations. The colorful spooky designs instantly add Halloween charm to gifts for kids, friends, family, and party guests.","price":5.99,"compareAtPrice":8.99,"currency":"USD","categorySlug":"printedandpapercrafts","images":["https://halloweenready.com/wp-content/uploads/2026/05/Halloween-Wrapping-Paper-Roll-–-2-Pack.png"],"inventory":200,"tags":["Halloween Decorations","Halloween Gift Wrap","Halloween Wrapping Paper","Party Favor","Spooky Gift Wrapping"],"seoTitle":"Halloween Wrapping Paper Roll – 2 Pack","seoDescription":"Wrap your spooky gifts in festive style with the Halloween Wrapping Paper Roll – 2 Pack."}]}]
