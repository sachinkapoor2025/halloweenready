2f:["$","$L30",null,{"product":{"name":"Pirate Eye Patch + Hook Set – Kids","slug":"pirate-eye-patch-hook-set-kids","description":"Set sail for adventure with the Pirate Eye Patch + Hook Set – Kids. This fun costume accessory set includes a classic pirate eye patch and matching pirate hook, perfect for Halloween parties, cosplay events, school plays, birthday celebrations, themed photoshoots, and imaginative dress-up fun. Designed especially for kids, the lightweight accessories are comfortable to wear and easy to use during parties and roleplay activities. The pirate eye patch adds an authentic captain look, while the pirate hook completes the adventurous costume style, making it ideal for pirate-themed outfits and fantasy dress-up.","price":3.36,"compareAtPrice":5.67,"currency":"USD","categorySlug":"costumesandaccessories","images":["https://halloweenready.com/wp-content/uploads/2026/05/Pirate-Eye-Patch-Hook-Set-–-Kids.png"],"inventory":200,"tags":["Halloween Costume Accessory","Pirate Costume Kids","Pirate Eye Patch","Pirate Hook"],"seoTitle":"Pirate Eye Patch + Hook Set – Kids","seoDescription":"Set sail for adventure with the Pirate Eye Patch + Hook Set – Kids."},"relatedProducts":[{"name":"Inflatable Pumpkin Costume – Adult","slug":"inflatable-pumpkin-costume-adult","description":"Get ready for laughs and spooky fun with the Inflatable Pumpkin Costume – Adult. This oversized inflatable Halloween costume features a bright pumpkin design that instantly transforms you into a giant festive pumpkin, making it perfect for Halloween parties, cosplay events, haunted houses, trick-or-treat celebrations, and costume competitions. Crafted from lightweight and breathable material, the costume includes a built-in air fan for quick inflation and comfortable wear throughout the event. The fun pumpkin shape creates a playful Halloween appearance that stands out at parties, stage performances, themed photoshoots, and social media content.","price":41.99,"compareAtPrice":42.99,"currency":"USD","categorySlug":"costumesandaccessories","images":["https://halloweenready.com/wp-content/uploads/2026/05/ffasfsdfsdv.png"],"inventory":200,"tags":["Funny Halloween Costume","Halloween Inflatable Outfit","Halloween Party S","Inflatable Pumpkin Costume","Pumpkin Costume Adult","Spooky Dress Up"],"seoTitle":"Inflatable Pumpkin Costume – Adult","seoDescription":"Get ready for laughs and spooky fun with the Inflatable Pumpkin Costume – Adult."},{"name":"Spider Headband – Black Glitter","slug":"spider-headband-black-glitter","description":"Spider Headband – Black Glitter. Featuring creepy spider accents with stylish black glitter detailing, this festive headband is perfect for Halloween parties, cosplay events, haunted houses, school celebrations, and spooky dress-up fun. Designed with a lightweight and comfortable fit, this headband is easy to wear for long hours during parties and themed events. The glittery black spider design creates a stylish gothic Halloween look that pairs perfectly with witch costumes, spider-themed outfits, vampire looks, and horror-inspired fashion.","price":3.36,"compareAtPrice":5.99,"currency":"USD","categorySlug":"costumesandaccessories","images":["https://halloweenready.com/wp-content/uploads/2026/05/ffsdv-1.png"],"inventory":200,"tags":["Black Glitter Headband","Halloween Costume Accessory","Halloween Headband","Spider Headband"],"seoTitle":"Spider Headband – Black Glitter","seoDescription":"Spider Headband – Black Glitter. Featuring creepy spider accents with stylish black glitter detailing, this festive headband is perfect for Halloween…"},{"name":"Grim Reaper Scythe Prop – Plastic 48in","slug":"grim-reaper-scythe-prop-plastic-48in","description":"Complete your terrifying Halloween look with the Grim Reaper Scythe Prop – Plastic 48in. Designed with a classic grim reaper style, this spooky prop features a long handle and realistic scythe blade appearance, making it the perfect accessory for Halloween costumes, haunted houses, cosplay events, stage performances, and horror-themed parties. Made from lightweight and durable plastic, this 48-inch scythe prop is easy to carry and comfortable to use during long hours of costume wear. Its realistic design instantly enhances grim reaper, skeleton, death angel, or horror-themed outfits for a dramatic spooky effect.","price":13.99,"compareAtPrice":16.89,"currency":"USD","categorySlug":"costumesandaccessories","images":["https://halloweenready.com/wp-content/uploads/2026/05/ffsdv.png"],"inventory":200,"tags":["Grim Reaper Scythe","Halloween Scythe Prop","Reaper Costume Accessory"],"seoTitle":"Grim Reaper Scythe Prop – Plastic 48in","seoDescription":"Complete your terrifying Halloween look with the Grim Reaper Scythe Prop – Plastic 48in."},{"name":"Fairy Wings – Purple/Black Child","slug":"fairy-wings-purple-black-child","description":"Lightweight and comfortable to wear, the wings feature secure elastic straps that make them easy for children to wear during parties and playtime. The enchanting fairy-style design creates a fun and stylish fantasy look, making them ideal for fairy costumes, witch themes, gothic outfits, butterfly cosplay, and magical character dress-up. Reusable and durable, these fairy wings are perfect for Halloween celebrations, costume competitions, themed photoshoots, and pretend play activities. Pair them with wands, tutus, dresses, or headbands for the ultimate fairy-inspired costume look.","price":7.99,"compareAtPrice":10.45,"currency":"USD","categorySlug":"costumesandaccessories","images":["https://halloweenready.com/wp-content/uploads/2026/05/ffv.png"],"inventory":200,"tags":["Fairy Wings","Halloween Costume Kids","Kids Fairy Costume","Purple Black Wings"],"seoTitle":"Fairy Wings – Purple/Black Child","seoDescription":"Lightweight and comfortable to wear, the wings feature secure elastic straps that make them easy for children to wear during parties and playtime."},{"name":"Black Wig – Straight Adult","slug":"black-wig-straight-adult","description":"Complete your spooky or stylish costume look with the Black Wig – Straight Adult. Featuring long straight black hair with a sleek and realistic appearance, this wig is perfect for Halloween parties, cosplay events, gothic fashion, stage performances, themed photoshoots, and costume dress-up. Made from lightweight and comfortable synthetic fibers, this adult wig is easy to wear for long hours while providing a natural and fashionable look. The smooth straight hairstyle makes it ideal for witch costumes, vampire outfits, gothic themes, cosplay characters, and horror-inspired fashion.","price":10.99,"compareAtPrice":13.78,"currency":"USD","categorySlug":"costumesandaccessories","images":["https://halloweenready.com/wp-content/uploads/2026/05/Black-Wig-–-Straight-Adult.png"],"inventory":200,"tags":["Adult Costume Wig","Black Wig","Gothic Wig","Halloween Wig","Straight Black Wig"],"seoTitle":"Black Wig – Straight Adult","seoDescription":"Complete your spooky or stylish costume look with the Black Wig – Straight Adult."}]}]
