2c:T510,{"@context":"https://schema.org","@type":"Product","@id":"http://localhost:3000/products/pirate-eye-patch-hook-set-kids#product","name":"Pirate Eye Patch + Hook Set – Kids","description":"Set sail for adventure with the Pirate Eye Patch + Hook Set – Kids.","image":["https://halloweenready.com/wp-content/uploads/2026/05/Pirate-Eye-Patch-Hook-Set-–-Kids.png"],"sku":"pirate-eye-patch-hook-set-kids","mpn":"pirate-eye-patch-hook-set-kids","url":"http://localhost:3000/products/pirate-eye-patch-hook-set-kids","brand":{"@type":"Brand","name":"HalloweenReady"},"category":"costumesandaccessories","offers":{"@type":"Offer","url":"http://localhost:3000/products/pirate-eye-patch-hook-set-kids","price":3.36,"priceCurrency":"USD","itemCondition":"https://schema.org/NewCondition","availability":"https://schema.org/InStock","seller":{"@id":"http://localhost:3000/#organization"},"shippingDetails":{"@type":"OfferShippingDetails","shippingRate":{"@type":"MonetaryAmount","value":"0","currency":"USD"},"deliveryTime":{"@type":"ShippingDeliveryTime","handlingTime":{"@type":"QuantitativeValue","minValue":0,"maxValue":1,"unitCode":"DAY"},"transitTime":{"@type":"QuantitativeValue","minValue":5,"maxValue":7,"unitCode":"DAY"}},"shippingDestination":{"@type":"DefinedRegion","addressCountry":"US"}}}}2d:T509,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does delivery take in the USA?","acceptedAnswer":{"@type":"Answer","text":"HalloweenReady delivers to all 50 US states in 5–7 business days after dispatch. Orders placed before our daily cut-off ship the same day."}},{"@type":"Question","name":"Can I order from India, UK, or Canada?","acceptedAnswer":{"@type":"Answer","text":"Yes. Enter your brother's US delivery address at checkout. We fulfill domestically inside America — no customs hassle for your brother."}},{"@type":"Question","name":"Is roli and chawal included?","acceptedAnswer":{"@type":"Answer","text":"Most single Halloween it