DYNAMODB_ENDPOINT=http://localhost:8000
ENVIRONMENT=local
NAME_PREFIX=occasionfun
# Per-domain tables (override individually if needed; default to occasionfun-<domain>-<ENVIRONMENT>)
PRODUCTS_TABLE=occasionfun-products-local
ORDERS_TABLE=occasionfun-orders-local
CARTS_TABLE=occasionfun-carts-local
CUSTOMERS_TABLE=occasionfun-customers-local
EVENTS_TABLE=occasionfun-events-local
CONFIG_TABLE=occasionfun-config-local
DEV_AUTH_ENABLED=true
USE_LOCAL_UPLOADS=true
USE_MEMORY_DB=true
LOCAL_API_URL=http://localhost:3001
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
# Stripe — set OCC_* GitHub secrets for occasionfun-prod (do not reuse HalloweenReady webhook endpoints)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email — NEVER commit real passwords
SMTP_HOST=mail.occasionfun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=order@occasionfun.com
SMTP_PASS=
SMTP_FROM=order@occasionfun.com
NOTIFY_EMAIL=order@occasionfun.com,order@usarakhi.com,priya.yadav@mydgv.com
# CJ Dropshipping — API Key from My CJ → Authorization → API (not the website password)
CJ_API_KEY=
