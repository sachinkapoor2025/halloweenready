DYNAMODB_ENDPOINT=http://localhost:8000
ENVIRONMENT=local
# Per-domain tables (override individually if needed; default to halloweenready-<domain>-<ENVIRONMENT>)
PRODUCTS_TABLE=halloweenready-products-local
ORDERS_TABLE=halloweenready-orders-local
CARTS_TABLE=halloweenready-carts-local
CUSTOMERS_TABLE=halloweenready-customers-local
EVENTS_TABLE=halloweenready-events-local
CONFIG_TABLE=halloweenready-config-local
DEV_AUTH_ENABLED=true
USE_LOCAL_UPLOADS=true
USE_MEMORY_DB=true
LOCAL_API_URL=http://localhost:3001
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
# Stripe — set in GitHub Secrets (deployed to Lambda via SAM); publishable key in Amplify
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...  (Amplify only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email notifications (contact form, new orders) — NEVER commit real passwords
SMTP_HOST=mail.halloweenready.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=order@halloweenready.com
SMTP_PASS=
SMTP_FROM=order@halloweenready.com
NOTIFY_EMAIL=order@halloweenready.com
# CJ Dropshipping — API Key from My CJ → Authorization → API (not the website password)
CJ_API_KEY=
