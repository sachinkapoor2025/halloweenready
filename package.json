{
  "name": "halloweenready",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @halloweenready/web",
    "dev:api": "npm run dev -w @halloweenready/api",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "tsx scripts/setup-local-db.ts",
    "seed": "tsx scripts/seed.ts",
    "import:halloweenready": "tsx scripts/import-halloweenready.ts",
    "import:halloweenready:fetch": "tsx scripts/import-halloweenready.ts --fetch-only",
    "seed:inventory": "tsx scripts/seed-inventory.ts",
    "fix:seo-descriptions": "tsx scripts/fix-seo-descriptions.ts",
    "generate:seo": "python3 scripts/generate-seo-from-keywords.py",
    "migrate:images": "tsx scripts/migrate-images-to-s3.ts",
    "import:backup-images": "tsx scripts/import-backup-product-images.ts",
    "sync:public-uploads": "tsx scripts/sync-public-uploads.ts",
    "rewrite:product-images": "tsx scripts/rewrite-product-image-urls.ts",
    "migrate:multitable": "tsx scripts/migrate-to-multitable.ts",
    "setup:local": "npm run db:up && sleep 3 && npm run db:setup && npm run seed",
    "build": "npm run build -w @halloweenready/shared && npm run build -w @halloweenready/api && npm run build -w @halloweenready/web",
    "lint": "npm run lint -w @halloweenready/web && npm run lint -w @halloweenready/api",
    "typecheck": "npm run typecheck -w @halloweenready/shared && npm run typecheck -w @halloweenready/api && npm run typecheck -w @halloweenready/web"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.716.0",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/lib-dynamodb": "^3.716.0",
    "concurrently": "^9.1.2",
    "sharp": "^0.35.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
